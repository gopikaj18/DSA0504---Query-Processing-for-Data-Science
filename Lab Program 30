import matplotlib.pyplot as plt
import numpy as np

men = [22, 30, 35, 35, 26]
women = [25, 32, 30, 35, 29]

x = np.arange(5)
width = 0.35

plt.bar(x - width/2, men, width, label='Men')
plt.bar(x + width/2, women, width, label='Women')

plt.xlabel('Groups')
plt.ylabel('Scores')
plt.title('Scores by Group and Gender')

plt.legend()
plt.show()
