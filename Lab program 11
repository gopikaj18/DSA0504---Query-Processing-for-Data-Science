import pandas as pd
import numpy as np

df = pd.DataFrame(np.random.rand(10, 4))

# Convert some values to NaN
df.iloc[1, 1] = np.nan
df.iloc[4, 2] = np.nan
df.iloc[7, 0] = np.nan

# Highlight NaN values
def highlight_nan(value):
    if pd.isna(value):
        return 'background-color: red'
    return ''

print(df.style.map(highlight_nan))
